# ==== Supabase ====
# Lấy tại: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# QUAN TRỌNG: dùng service_role key (không phải anon key) — key này có toàn quyền,
# CHỈ dùng ở backend, TUYỆT ĐỐI không lộ ra frontend hay commit lên git công khai.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Tên bucket Storage chứa ảnh/audio (tạo ở Dashboard -> Storage, đánh dấu Public)
SUPABASE_BUCKET=lesson-media

# ==== Auth (JWT tự quản, tách biệt với Supabase Auth) ====
JWT_SECRET=doi-chuoi-nay-thanh-random-dai-va-bi-mat
JWT_EXPIRES_IN=7d

# ==== Server ====
PORT=5000
CORS_ORIGIN=http://localhost:5173

# ==== Upload ====
# Kích thước file tối đa (MB) cho mỗi lần upload qua /api/admin/uploads
MAX_UPLOAD_MB=15

# ==== Tài khoản admin tạo khi chạy `npm run seed` (chỉ tạo nếu chưa tồn tại) ====
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@hanzi-course.local
SEED_ADMIN_PASSWORD=ChangeMe123!
