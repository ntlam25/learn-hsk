  "properNouns": [],
  "dialogues": [
    {
      "title": "（一）这个黑箱子很重",
      "lines": [
        {
          "role": "A",
          "text": "你没有箱子吗？"
        },
        {
          "role": "B",
          "text": "有啊。我的在这儿呢。"
        },
        {
          "role": "A",
          "text": "我的很重，你的重不重？"
        },
        {
          "role": "B",
          "text": "这个黑的很重，那个红的比较轻。"
        },
        {
          "role": "A",
          "text": "你的箱子很新，我的很旧。"
        },
        {
          "role": "B",
          "text": "那个新的是朋友的。这个旧的是我的。"
        }
      ]
    },
    {
      "title": "（二）这是不是中药",
      "lines": [
        {
          "role": "A",
          "text": "先生，这些黑的是什么？"
        },
        {
          "role": "B",
          "text": "这是一些药。"
        },
        {
          "role": "A",
          "text": "什么药？"
        },
        {
          "role": "B",
          "text": "中药。"
        },
        {
          "role": "A",
          "text": "这是不是药？"
        },
        {
          "role": "B",
          "text": "这不是药，这是茶叶。"
        },
        {
          "role": "A",
          "text": "那个箱子里是什么？"
        },
        {
          "role": "B",
          "text": "都是日用品。有两件衣服、一把雨伞和一个平板电脑，还有一本书、一本词典、两个优盘和三支毛笔。"
        }
      ]
    }
