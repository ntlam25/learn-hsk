  "exercises": {
    "grammar": [
      {
        "title": "数量词“些”",
        "content": "些 biểu thị số lượng không xác định; thường đi sau 一、哪、这、那: 一些人、这些书、那些杂志. Không dùng với số từ khác."
      },
      {
        "title": "形容词谓语句",
        "content": "Câu vị ngữ tính từ: chủ ngữ + phó từ + tính từ. Ví dụ: 这个箱子很重；苹果比较贵。Không thêm 是 trước tính từ."
      },
      {
        "title": "正反疑问句",
        "content": "Dùng dạng khẳng định + phủ định để hỏi: 是不是、有没有、重不重、去不去. Trả lời bằng dạng khẳng định hoặc phủ định."
      },
      {
        "title": "定语和“的”",
        "content": "Miêu tả/sở hữu + 的 + danh từ: 黑色的箱子、我的书. Tính từ đơn âm tiết có thể bỏ 的: 黑箱子、旧书."
      },
      {
        "title": "“的”字短语",
        "content": "的 có thể thay cho danh từ bị lược: 我的很旧；红的是我的；那个新的是朋友的。"
      },
      {
        "title": "方位词“里”",
        "content": "Danh từ + 里 biểu thị bên trong: 箱子里、房间里、学校里."
      },
      {
        "title": "量词搭配",
        "content": "件衣服、把雨伞、本词典、个优盘、支笔、瓶香水、张地图。"
      }
    ]
  },
