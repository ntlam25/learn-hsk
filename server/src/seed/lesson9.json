    {
      "title": "在中国银行换钱",
      "lines": [
        {
          "role": "麦克",
          "text": "小姐，我换钱。"
        },
        {
          "role": "营业员",
          "text": "您换什么钱？"
        },
        {
          "role": "麦克",
          "text": "我换人民币。"
        },
        {
          "role": "营业员",
          "text": "换多少？"
        },
        {
          "role": "麦克",
          "text": "二百美元。"
        },
        {
          "role": "营业员",
          "text": "请等一会儿。……先生，给您钱。请数数。"
        },
        {
          "role": "麦克",
          "text": "对。谢谢！"
        },
        {
          "role": "营业员",
          "text": "不客气！"
        }
      ]
    }
