  "properNouns": [],
  "dialogues": [
    {
      "title": "（一）你家有几口人",
      "lines": [
        {
          "role": "麦克",
          "text": "你家有几口人？"
        },
        {
          "role": "玛丽",
          "text": "我家有五口人，爸爸、妈妈、哥哥、姐姐和我。"
        },
        {
          "role": "麦克",
          "text": "你有没有全家的照片？"
        },
        {
          "role": "玛丽",
          "text": "有一张。你看，这是我们全家的照片。"
        },
        {
          "role": "麦克",
          "text": "你有哥哥姐姐吗？"
        },
        {
          "role": "玛丽",
          "text": "我没有哥哥，也没有姐姐，只有两个弟弟。"
        },
        {
          "role": "玛丽",
          "text": "你爸爸、妈妈做什么工作？"
        },
        {
          "role": "麦克",
          "text": "我妈妈是大夫，在医院工作，爸爸是一家公司的经理。"
        },
        {
          "role": "玛丽",
          "text": "我妈妈在商店工作，爸爸是律师。"
        }
      ]
    },
    {
      "title": "（二）你们公司有多少员工",
      "lines": [
        {
          "role": "王老师",
          "text": "你们是一家什么公司？"
        },
        {
          "role": "关经理",
          "text": "是一家外贸公司。"
        },
        {
          "role": "王老师",
          "text": "是一家大公司吗？"
        },
        {
          "role": "关经理",
          "text": "不是。是一家比较小的公司。"
        },
        {
          "role": "王老师",
          "text": "有多少员工？"
        },
        {
          "role": "关经理",
          "text": "大概有一百多个员工。"
        },
        {
          "role": "王老师",
          "text": "都是中国员工吗？"
        },
        {
          "role": "关经理",
          "text": "不都是中国员工，也有外国员工。"
        }
      ]
    }
  ],
  "exercises": {
    "grammar": [
      {
        "title": "有字句 · Sở hữu",
        "content": "Chủ ngữ + 有 + tân ngữ: 我有一本词典. Phủ định dùng 没有; nghi vấn dùng 有……吗 hoặc 有没有……？"
      },
      {
        "title": "有字句 · Tồn tại",
        "content": "Địa điểm/tổ chức + 有 + người/vật: 我家有五口人；公司有一百多个职员。"
      },
      {
        "title": "几 và 多少",
        "content": "几 thường hỏi số nhỏ, có thể dự đoán dưới 10; 多少 hỏi số lớn hoặc không ước tính được."
      },
      {
        "title": "Cụm số lượng",
        "content": "Số từ + lượng từ + danh từ: 一张照片、两本书、三辆车、五口人。"
      },
      {
        "title": "二 và 两",
        "content": "两 dùng trước lượng từ, 千, 万: 两个人、两千；二 dùng khi đếm và trong 二十、二百、二月、二楼。"
      },
      {
        "title": "不都是 và 都不是",
        "content": "不都是 = không phải tất cả; 都不是 = tất cả đều không/phủ định toàn bộ."
      },
      {
        "title": "只",
        "content": "只 đứng trước động từ hoặc 有: 我只看书；我只有两个弟弟。"
      }
    ]
  },
