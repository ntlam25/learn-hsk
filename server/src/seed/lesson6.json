  "dialogues": [
    { "title": "（一）我学习汉语 · Wǒ xuéxí Hànyǔ",
      "lines": [
        { "role": "麦克", "text": "请问，你贵姓？", "py": "Qǐngwèn, nǐ guìxìng?" },
        { "role": "张东", "text": "我姓张。", "py": "Wǒ xìng Zhāng." },
        { "role": "麦克", "text": "你叫什么名字？", "py": "Nǐ jiào shénme míngzi?" },
        { "role": "张东", "text": "我叫张东。", "py": "Wǒ jiào Zhāng Dōng." },
        { "role": "麦克", "text": "你是哪国人？", "py": "Nǐ shì nǎ guó rén?" },
        { "role": "张东", "text": "我是中国人。你是哪国人？", "py": "Wǒ shì Zhōngguó rén. Nǐ shì nǎ guó rén?" },
        { "role": "麦克", "text": "我是美国人。", "py": "Wǒ shì Měiguó rén." },
        { "role": "张东", "text": "认识你很高兴。", "py": "Rènshi nǐ hěn gāoxìng." },
        { "role": "麦克", "text": "认识你我也很高兴。", "py": "Rènshi nǐ, wǒ yě hěn gāoxìng." },
        { "role": "张东", "text": "你学习什么？", "py": "Nǐ xuéxí shénme?" },
        { "role": "麦克", "text": "我学习汉语。", "py": "Wǒ xuéxí Hànyǔ." },
        { "role": "张东", "text": "汉语难吗？", "py": "Hànyǔ nán ma?" },
        { "role": "麦克", "text": "发音不太难，汉字很难。", "py": "Fāyīn bú tài nán, Hànzì hěn nán." }
      ] },
    { "title": "（二）这是什么书 · Zhè shì shénme shū",
      "lines": [
        { "role": "A", "text": "这是什么？", "py": "Zhè shì shénme?" },
        { "role": "B", "text": "这是书。", "py": "Zhè shì shū." },
        { "role": "A", "text": "这是什么书？", "py": "Zhè shì shénme shū?" },
        { "role": "B", "text": "这是中文书。", "py": "Zhè shì Zhōngwén shū." },
        { "role": "A", "text": "这是谁的书？", "py": "Zhè shì shéi de shū?" },
        { "role": "B", "text": "这是老师的书。", "py": "Zhè shì lǎoshī de shū." },
        { "gap": true },
        { "role": "A", "text": "那是什么？", "py": "Nà shì shénme?" },
        { "role": "B", "text": "那是杂志。", "py": "Nà shì zázhì." },
        { "role": "A", "text": "那是什么杂志？", "py": "Nà shì shénme zázhì?" },
        { "role": "B", "text": "那是英文杂志。", "py": "Nà shì Yīngwén zázhì." },
        { "role": "A", "text": "那是谁的杂志？", "py": "Nà shì shéi de zázhì?" },
        { "role": "B", "text": "那是我朋友的杂志。", "py": "Nà shì wǒ péngyou de zázhì." }
      ] }
  ],
