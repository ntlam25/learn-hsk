  "dialogues": [
    {
      "title": "（一）我学习汉语",
      "context": "",
      "lines": [
        {
          "role": "麦克",
          "text": "请问，你贵姓？"
        },
        {
          "role": "张东",
          "text": "我姓张。"
        },
        {
          "role": "麦克",
          "text": "你叫什么名字？"
        },
        {
          "role": "张东",
          "text": "我叫张东。"
        },
        {
          "role": "麦克",
          "text": "你是哪国人？"
        },
        {
          "role": "张东",
          "text": "我是中国人。你是哪国人？"
        },
        {
          "role": "麦克",
          "text": "我是美国人。"
        },
        {
          "role": "张东",
          "text": "认识你很高兴。"
        },
        {
          "role": "麦克",
          "text": "认识你我也很高兴。"
        },
        {
          "role": "张东",
          "text": "你学习什么？"
        },
        {
          "role": "麦克",
          "text": "我学习汉语。"
        },
        {
          "role": "张东",
          "text": "汉语难吗？"
        },
        {
          "role": "麦克",
          "text": "发音不太难，汉字很难。"
        }
      ]
    },
    {
      "title": "（二）这是什么书",
      "context": "（桌子上有两个邮包）",
      "lines": [
        {
          "role": "A",
          "text": "这是什么？"
        },
        {
          "role": "B",
          "text": "这是书。"
        },
        {
          "role": "A",
          "text": "这是什么书？"
        },
        {
          "role": "B",
          "text": "这是中文书。"
        },
        {
          "role": "A",
          "text": "这是谁的书？"
        },
        {
          "role": "B",
          "text": "这是老师的书。"
        },
        {
          "role": "A",
          "text": "那是什么？"
        },
        {
          "role": "B",
          "text": "那是杂志。"
        },
        {
          "role": "A",
          "text": "那是什么杂志？"
        },
        {
          "role": "B",
          "text": "那是英文杂志。"
        },
        {
          "role": "A",
          "text": "那是谁的杂志？"
        },
        {
          "role": "B",
          "text": "那是我朋友的杂志。"
        }
      ]
    }
