  "exercises": {
    "notes": [
      {
        "title": "j、q、x + ü",
        "content": "Khi j, q, x đứng trước ü, bỏ hai chấm khi viết: ju、qu、xu; cách đọc vẫn là ü."
      },
      {
        "title": "鼻韵母 · Vận mẫu mũi",
        "content": "an、en、ang、eng、ong. Phân biệt rõ -n và -ng."
      },
      {
        "title": "i / ü 系列韵母",
        "content": "ia、ie、iao、iou(-iu)、ian、in、iang、ing、iong；üe、üan、ün."
      },
      {
        "title": "轻声 · Thanh nhẹ",
        "content": "妈妈、爸爸、哥哥、弟弟、妹妹、吗: âm tiết thanh nhẹ đọc ngắn và không ghi dấu thanh."
      },
      {
        "title": "半三声 · Nửa thanh 3",
        "content": "Thanh 3 đứng trước thanh 1, 2, 4 hoặc thanh nhẹ thường chỉ đọc phần đi xuống: hěn máng、hǎo ma."
      },
      {
        "title": "不 的变调 · Biến điệu 不",
        "content": "Trước thanh 4, 不 đọc bú: 不大 bú dà；trước thanh 1, 2, 3 giữ bù: 不难 bù nán."
      },
      {
        "title": "y / w 的写法",
        "content": "Khi i, u, ü đứng đầu âm tiết, viết thành yi, wu, yu; cách đọc nguyên âm không đổi."
      }
    ],
    "grammar": [
      {
        "title": "吗 疑问句",
        "content": "Thêm 吗 cuối câu trần thuật để tạo câu hỏi có/không: 你忙吗？汉语难吗？"
      },
      {
        "title": "很 + 形容词",
        "content": "Trong câu vị ngữ tính từ, 很 thường đứng trước tính từ: 我很好；他很忙。"
      },
      {
        "title": "不太 + 形容词",
        "content": "不太 biểu thị mức độ phủ định nhẹ: 不太难 = không khó lắm; 不太忙 = không bận lắm."
      },
      {
        "title": "太 + 形容词 + 了",
        "content": "Dùng để cảm thán mức độ: 太好了！太难了！"
      }
    ],
