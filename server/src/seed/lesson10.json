  "dialogues": [
    {
      "title": "课文",
      "lines": [
        {
          "role": "李昌浩",
          "text": "请问，这是办公室吗？"
        },
        {
          "role": "老师",
          "text": "是。你找谁？"
        },
        {
          "role": "李昌浩",
          "text": "王老师在吗？我是他的学生。"
        },
        {
          "role": "老师",
          "text": "他不在。他在家呢。"
        },
        {
          "role": "李昌浩",
          "text": "他住哪儿？"
        },
        {
          "role": "老师",
          "text": "他住18号楼1门601房间。"
        },
        {
          "role": "李昌浩",
          "text": "您知道他家的电话号码吗？"
        },
        {
          "role": "老师",
          "text": "知道，62931074。"
        },
        {
          "role": "李昌浩",
          "text": "他的手机号码是多少？"
        },
        {
          "role": "老师",
          "text": "不知道。"
        },
        {
          "role": "李昌浩",
          "text": "谢谢您。"
        },
        {
          "role": "老师",
          "text": "不客气。"
        }
      ]
    }
  ],
  "exercises": {
    "notes": [
      {
        "title": "号码的读法 · Cách đọc mã số",
        "content": "Mã số, số phòng và số điện thoại được đọc từng chữ số một, không đọc theo hàng chục, hàng trăm."
      },
      {
        "title": "“一”读 yāo",
        "content": "Trong mã số và số điện thoại, số 1 thường đọc yāo để tránh nhầm: 601 → liù líng yāo."
      },
      {
        "title": "“二”读 èr",
        "content": "Trong mã số, số 2 đọc èr, không đọc liǎng: 223 → èr èr sān."
      },
      {
        "title": "零 líng",
        "content": "Số 0 đọc líng. Ví dụ: 62931074 → liù èr jiǔ sān yāo líng qī sì."
      },
      {
        "title": "轻声“呢”",
        "content": "呢 đọc ngắn, nhẹ; không ghi dấu thanh. Khi đọc câu 他在家呢, giọng cuối mềm và có tính xác nhận."
      }
    ],
    "grammar": [
      {
        "title": "“呢”询问地点",
        "content": "Khi không có câu trước, 呢 có thể hỏi đồ vật/người ở đâu: 我的书呢？你爸爸呢？"
      },
      {
        "title": "“呢”承接上文",
        "content": "Sau một câu trước đó, 呢 dùng để hỏi tương tự: 我是越南人，你呢？"
      },
      {
        "title": "住（在）+ 地点",
        "content": "Cấu trúc nói nơi cư trú: 我住在河内；他住十八楼一门。"
      },
      {
        "title": "号码是多少",
        "content": "Dùng “danh từ + 号码是多少？” để hỏi mã số: 你的电话号码是多少？他的房间号码是多少？"
      },
      {
        "title": "知道 / 不知道",
        "content": "Dùng 知道 để nói biết thông tin; phủ định bằng 不知道: 你知道吗？— 知道。/ 不知道。"
      },
      {
        "title": "在 / 不在",
        "content": "Dùng 在 để hỏi một người có mặt không: 王老师在吗？— 他不在。"
      }
    ],
