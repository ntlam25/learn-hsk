  "exercises": {
    "notes": [
      {
        "title": "z、c、s",
        "content": "z không bật hơi; c bật hơi; s là âm xát. Luyện: zī、cí、sī và 再见、词典、公司。"
      },
      {
        "title": "zh、ch、sh、r",
        "content": "Nhóm âm đầu cuốn lưỡi. Đầu lưỡi cong nhẹ lên phía vòm cứng; ch bật hơi mạnh hơn zh."
      },
      {
        "title": "特殊韵母 -i",
        "content": "Sau z、c、s、zh、ch、sh、r, chữ i không đọc như “i” thông thường mà gần âm “ư”: zi、ci、si、zhi、chi、shi、ri."
      },
      {
        "title": "韵母 er",
        "content": "er có thể tự tạo thành âm tiết, không cần thanh mẫu: 儿、耳、二。"
      },
      {
        "title": "儿化音",
        "content": "Thêm r sau âm tiết để tạo vần cuốn lưỡi: 画儿 huàr、花儿 huār、哪儿 nǎr、那儿 nàr、玩儿 wánr。"
      },
      {
        "title": "u 系列韵母",
        "content": "ua、uo、uai、ui(uei)、uan、un(uen)、uang、ueng. Chú ý dạng viết tắt ui và un."
      }
    ],
    "grammar": [
      {
        "title": "吗 疑问句",
        "content": "Thêm 吗 cuối câu trần thuật để hỏi có/không: 你学英语吗？你去北京吗？"
      },
      {
        "title": "正反疑问句",
        "content": "Đặt động từ khẳng định và phủ định cạnh nhau: 去不去、对不对. Không thêm 吗 ở cuối."
      },
      {
        "title": "连动结构",
        "content": "Dùng nhiều động từ liên tiếp để biểu thị mục đích: 去邮局寄信、去银行取钱。"
      },
      {
        "title": "时间 + 见",
        "content": "Dùng thời gian hoặc địa điểm trước 见 để hẹn gặp: 明天见、北京见、韩国见。"
      },
      {
        "title": "省略主语",
        "content": "Trong hội thoại, chủ ngữ có thể được lược khi ngữ cảnh rõ: 不去。去银行取钱。"
      }
