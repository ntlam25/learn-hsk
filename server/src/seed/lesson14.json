  "dialogues": [
    {
      "title": "（一）您身体好吗",
      "lines": [
        {
          "role": "关经理",
          "text": "王老师，好久不见了。"
        },
        {
          "role": "王老师",
          "text": "啊！关经理，欢迎，欢迎！"
        },
        {
          "role": "关经理",
          "text": "您身体好吗？"
        },
        {
          "role": "王老师",
          "text": "很好。您身体怎么样？"
        },
        {
          "role": "关经理",
          "text": "马马虎虎。"
        },
        {
          "role": "王老师",
          "text": "最近工作忙不忙？"
        },
        {
          "role": "关经理",
          "text": "不太忙。您呢？"
        },
        {
          "role": "王老师",
          "text": "刚开学，有点儿忙。喝点儿什么？茶还是咖啡？"
        },
        {
          "role": "关经理",
          "text": "来杯茶吧！"
        }
      ]
    },
    {
      "title": "（二）你的自行车是新的还是旧的",
      "lines": [
        {
          "role": "田芳",
          "text": "我的车呢？"
        },
        {
          "role": "张东",
          "text": "你的车是什么颜色的？"
        },
        {
          "role": "田芳",
          "text": "蓝的。"
        },
        {
          "role": "张东",
          "text": "是新的还是旧的？"
        },
        {
          "role": "田芳",
          "text": "新的。"
        },
        {
          "role": "张东",
          "text": "那辆蓝的是不是你的？"
        },
        {
          "role": "田芳",
          "text": "哪辆？"
        },
        {
          "role": "张东",
          "text": "那辆。"
        },
        {
          "role": "田芳",
          "text": "不是。……啊，在那儿呢。"
        }
      ]
    }
  ],
  "exercises": {
    "grammar": [
      {
        "title": "选择疑问句“还是”",
        "content": "Khi đưa ra hai hoặc nhiều khả năng để người nghe lựa chọn, dùng 还是: 你今天去还是明天去？茶还是咖啡？"
      },
      {
        "title": "省略疑问句“呢”",
        "content": "Không có câu trước: 我的自行车呢？= 我的自行车在哪儿？ Có câu trước: 我是英国人，你呢？"
      },
      {
        "title": "主谓谓语句",
        "content": "Câu có vị ngữ là một cụm chủ-vị: 我身体很好；她工作很忙。 Chủ ngữ lớn nêu đối tượng, cụm chủ-vị phía sau miêu tả đối tượng đó."
      },
      {
        "title": "有点儿 + 形容词",
        "content": "有点儿 đứng trước tính từ: 有点儿忙、有点儿贵、有点儿重. Thường mang sắc thái chưa hài lòng."
      },
      {
        "title": "动词 + 一点儿",
        "content": "一点儿 đứng sau động từ hoặc trước danh từ: 喝一点儿、吃一点儿、买一点儿水果。"
      },
      {
        "title": "最 + 形容词/动词",
        "content": "最 biểu thị mức độ cao nhất: 最好、最难、最好吃、最好看。"
      },
      {
        "title": "刚 + 动词",
        "content": "刚 biểu thị hành động vừa xảy ra: 刚开学、刚回家、刚去银行。"
      },
      {
        "title": "“的”字短语",
        "content": "Có thể lược danh từ sau 的 khi đã rõ: 蓝的、新的、旧的、我的、田芳的。"
      }
    ]
  },
