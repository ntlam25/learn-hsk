  "dialogues": [
    {
      "title": "课文",
      "lines": [
        {
          "role": "A",
          "text": "您好，您买什么？"
        },
        {
          "role": "B",
          "text": "我买水果。苹果一斤多少钱？"
        },
        {
          "role": "A",
          "text": "六块。"
        },
        {
          "role": "B",
          "text": "六块？太贵了。便宜点儿吧。"
        },
        {
          "role": "A",
          "text": "你要多少？"
        },
        {
          "role": "B",
          "text": "来五个吧。"
        },
        {
          "role": "A",
          "text": "还要别的吗？"
        },
        {
          "role": "B",
          "text": "橘子怎么卖？"
        },
        {
          "role": "A",
          "text": "八块。"
        },
        {
          "role": "B",
          "text": "要两斤吧。一共多少钱？"
        },
        {
          "role": "A",
          "text": "一共二十一块三（毛）。你给二十一吧。"
        },
        {
          "role": "B",
          "text": "好。给你钱。"
        },
        {
          "role": "A",
          "text": "这是五十，找您二十九块。"
        }
      ]
    }
  ],
